# Server Configuration
PORT=3000
NODE_ENV=local
DB_URI=mongodb://localhost:27017/frontendly
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
ACCESS_TOKEN_EXPIRES_IN=3h
PASSWORD_RESET_EXPIRES_IN_MINUTES=15
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15

# Email Configuration (Required for password reset emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@frontendly.com

# Cloudinary Configuration (Required for avatar uploads)
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name

# Observability
O11Y_HEAP_THRESHOLD_BYTES=1073741824
